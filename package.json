{
	"name": "endofline",
	"displayName": "EndOfLine",
	"description": "Display end-of-line characters with custom symbols and styles",
	"version": "0.1.0",
	"author": {
		"name": "Baptiste Augrain",
		"email": "daiyam@zokugun.org"
	},
	"publisher": "zokugun",
	"license": "MIT",
	"homepage": "https://github.com/zokugun/vscode-endofline",
	"repository": {
		"type": "git",
		"url": "https://github.com/zokugun/vscode-endofline.git"
	},
	"bugs": {
		"url": "https://github.com/zokugun/vscode-endofline/issues"
	},
	"engines": {
		"vscode": "^1.23.0"
	},
	"main": "./lib/index.js",
	"browser": "./lib/index.js",
	"scripts": {
		"audit:fix": "npm audit fix --min-release-age=0",
		"build": "npm run clean && npm run compile:src && npm run bundle",
		"bundle": "ncc build out/extension --out lib",
		"ci:lint": "zizmor .",
		"ci:lint:fix": "zizmor . --fix=all",
		"clean": "rimraf lib out",
		"compile:src": "tsc -p src",
		"lint": "xo",
		"lint:all": "npm run lint:package && npm audit && npm run ci:lint && npm run lint",
		"lint:fix": "xo --fix",
		"lint:package": "fixpack || true",
		"package": "rimraf *.vsix && vsce package",
		"prepare": "husky; npm run lint:package",
		"release": "release-it",
		"update:artifacts": "artifact update",
		"update:ci": "PINACT_MIN_AGE=7 pinact run --update",
		"update:deps": "taze --all",
		"vscode:prepublish": "npm run build",
		"watch:src": "tsc-watch -p src --onSuccess 'npm run bundle'"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "20.5.3",
		"@commitlint/config-conventional": "20.5.3",
		"@types/node": "20.19.39",
		"@types/vscode": "1.56.0",
		"@vercel/ncc": "^0.38.3",
		"fixpack": "4.0.0",
		"husky": "9.1.7",
		"lint-staged": "16.4.0",
		"release-it": "20.0.1",
		"rimraf": "6.1.3",
		"taze": "19.14.1",
		"tsc-watch": "7.2.0",
		"typescript": "5.9.3",
		"xo": "0.60.0"
	},
	"overrides": {
		"ajv": {
			"fast-uri": "3.1.2"
		},
		"@inquirer/core": {
			"mute-stream": "3.0.0"
		}
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [],
		"configuration": {
			"title": "EndOfLine",
			"properties": {
				"endofline.cr.symbol": {
					"type": "string",
					"minLength": 0,
					"maxLength": 1,
					"default": "¤",
					"description": "Symbol displayed for CR (\\r), the end-of-line sequence for Classic Mac.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.cr.style": {
					"type": "object",
					"default": {},
					"description": "Style attributes (e.g., color, opacity) used to display this EOL symbol.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.crlf.symbol": {
					"type": "string",
					"minLength": 0,
					"maxLength": 2,
					"default": "¤¬",
					"description": "Symbol displayed for CRLF (\\r\\n), the end-of-line sequence for Windows.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.crlf.style": {
					"type": "object",
					"default": {},
					"description": "Style attributes (e.g., color, opacity) used to display this EOL symbol.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.enabled": {
					"title": "Enabled",
					"type": "boolean",
					"default": true,
					"description": "Controls whether to display the EOL symbols or not.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.lf.symbol": {
					"type": "string",
					"minLength": 0,
					"maxLength": 1,
					"default": "¬",
					"description": "Symbol displayed for LF (\\n), the end-of-line sequence for Linux and macOS.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.lf.style": {
					"type": "object",
					"default": {},
					"description": "Style attributes (e.g., color, opacity) used to display this EOL symbol.",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				},
				"endofline.notification": {
					"type": "string",
					"enum": [
						"none",
						"major",
						"minor",
						"patch"
					],
					"default": "minor",
					"description": "Display notification when a new version is installed",
					"enumDescriptions": [
						"The new version notification won't be shown anymore.",
						"The new version notification will be shown only with a new major version",
						"The new version notification will be shown only with a new minor version",
						"The new version notification will always be shown"
					],
					"scope": "application",
					"tags": [
						"eol"
					]
				},
				"endofline.style": {
					"type": "object",
					"default": {},
					"description": "Style attributes (e.g., color, opacity) used to display any EOL symbols. Ex: \"endofline.style\" { \"color\" : \"#009999\", \"opacity\" : 0.7 }",
					"scope": "language-overridable",
					"tags": [
						"eol"
					]
				}
			}
		}
	},
	"icon": "icon.png",
	"galleryBanner": {
		"color": "#DDE7FB",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"crlf",
		"end-of-line",
		"eol",
		"lf",
		"line ending",
		"render crlf"
	],
	"extensionKind": [
		"ui",
		"workspace"
	]
}
